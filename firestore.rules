rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The only account that may change data. Replace the value with the UID of your admin user
    // (Firebase Console -> Authentication -> Users -> User UID) before using a real Firebase project.
    //
    // The default below is a placeholder used with the local emulator (`npm run seed` creates a
    // user with this UID). Firebase assigns random UIDs, so nobody can sign up as "dev-admin-uid"
    // on a real project: until you replace it, nobody is an admin and every write is denied.
    // Keep this value identical in storage.rules.
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'dev-admin-uid';
    }

    // YYYY-MM-DD with a month from 01 to 12 and a day from 01 to 31. The rules cannot know which months have
    // 31 days: the admin form only produces real calendar dates.
    function isDateString(value) {
      return value is string
             && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isValidProduct(data) {
      return data.keys().hasOnly([
               'name', 'price', 'category', 'description', 'dateType',
               'lastUseDate', 'image', 'stockCount', 'priceLastUpdate'
             ])
             && data.keys().hasAll([
               'name', 'price', 'category', 'description', 'dateType',
               'lastUseDate', 'image', 'stockCount', 'priceLastUpdate'
             ])
             && data.name is string && data.name.size() >= 2 && data.name.size() <= 70
             && data.price is number && data.price > 0 && data.price <= 1000000
             && data.category is string && data.category.size() >= 1 && data.category.size() <= 40
             && data.description is string && data.description.size() <= 1000
             && data.dateType in ['SKT', 'TETT']
             && data.lastUseDate is string && (data.lastUseDate == '' || isDateString(data.lastUseDate))
             && data.image is string && data.image.size() <= 2048
             && (data.image == '' || data.image.matches('^https?://.*'))
             && data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 1000000
             && isDateString(data.priceLastUpdate);
    }

    match /products/{productId} {
      // A customer opening a QR code can read that one product, but cannot list the catalogue.
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // Store-wide settings. Only the admin may read or write them, and only one document exists:
    // settings/site, the address that QR codes point to (so it is the same on every device).
    match /settings/{settingId} {
      allow get: if isAdmin() && settingId == 'site';
      allow create, update: if isAdmin() && settingId == 'site'
                            && request.resource.data.keys().hasOnly(['siteUrl'])
                            && request.resource.data.siteUrl is string
                            && request.resource.data.siteUrl.size() >= 8
                            && request.resource.data.siteUrl.size() <= 200
                            && request.resource.data.siteUrl.matches('^https?://[^ ]+$');
      allow delete: if isAdmin() && settingId == 'site';
    }

    // Everything else is denied by default.
  }
}
